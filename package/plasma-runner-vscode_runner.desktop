[Desktop Entry]
Name=VSCode
Comment=Easily access VSCode recent workspaces
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=com.visualstudio.code
X-KDE-PluginInfo-Author=Niklas Sirch
X-KDE-PluginInfo-Email=temp@gmail.com
X-KDE-PluginInfo-Name=vscode_runner
X-KDE-PluginInfo-Version=2.0
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=sirchnik.vscode_runner
X-Plasma-DBusRunner-Path=/vscode_runner
